{
  "name": "jizhengzhixing-site",
  "main": "src/site-worker.mjs",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "createmore.asia",
      "custom_domain": true
    },
    {
      "pattern": "www.createmore.asia",
      "custom_domain": true
    }
  ]
}
