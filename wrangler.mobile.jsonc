{
  "name": "jizhengzhixing-mobile",
  "main": "src/mobile-worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./mobile/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1091",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
