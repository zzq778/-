{
  "name": "jizhengzhixing-ai-demo",
  "version": "0.9.0",
  "description": "吉政知行吉林政务与文旅智能助手桌面端",
  "author": "吉政知行项目组",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "build:data": "node scripts/build-wenlv-data.mjs",
    "facts": "node scripts/wenlv-facts.mjs",
    "facts:write": "node scripts/wenlv-facts.mjs --write",
    "test": "node --test tests/*.test.mjs",
    "build:mobile": "node scripts/build-mobile-workspaces.mjs",
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "wrangler": "^4.0.0"
  },
  "build": {
    "appId": "asia.createmore.jizhengzhixing",
    "productName": "吉政知行",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/assets/icon-512.png",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "吉政知行-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "吉政知行"
    },
    "portable": {
      "artifactName": "吉政知行-便携版-${version}-${arch}.${ext}"
    }
  }
}
